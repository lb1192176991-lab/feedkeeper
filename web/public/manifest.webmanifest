{
  "name": "FeedKeeper",
  "short_name": "FeedKeeper",
  "description": "Self-hosted RSS/Atom reader and remote MCP server for AI assistants.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0f17",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "/app-icon-180.png?v=2",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/app-icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Saved articles",
      "short_name": "Saved",
      "url": "/items?saved=1",
      "icons": [
        {
          "src": "/app-icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add feed",
      "short_name": "Add feed",
      "url": "/feeds?add=1",
      "icons": [
        {
          "src": "/app-icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/feeds",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
